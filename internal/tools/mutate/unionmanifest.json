    {
      "id": "P2-3",
      "batch": "P2",
      "name": "A branch selecting more columns than the first stops being refused",
      "mutation": {
        "file": "resultshape.go",
        "anchor": "unionclasses/P2-3/anchor.txt",
        "replacement": "unionclasses/P2-3/replacement.txt",
        "count": 1,
        "expresses": [
          "The column-count comparison is weakened from inequality to 'the first",
          "branch must not be wider', so a later branch with extra columns is accepted",
          "and only its leading columns are ever compared. The statement then fails in",
          "PostgreSQL rather than at construction, which is the failure this",
          "milestone exists to move earlier."
        ]
      },
      "precondition": {
        "expect": [
          "TestUnionMutationPrecondition/P2-3"
        ],
        "argv": [
          "go",
          "test",
          "-json",
          "-count=1",
          ".",
          "-run",
          "^TestUnionMutationPrecondition$/^P2-3$"
